{
  "name": "kalamos-write-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Canonical ruled-writing feature in the Kalamos monorepo.",
  "scripts": {
    "check:sources": "node scripts/check-source-graph.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && bash scripts/build-android.sh",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
