<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="60dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="8dp" android:paddingEnd="12dp" android:background="#FFFFFF">
    <Button android:id="@+id/agoraBack" android:layout_width="48dp" android:layout_height="48dp"
        android:minWidth="0dp" android:padding="0dp" android:text="‹" android:textSize="32sp"
        android:contentDescription="Back to Agora" android:textColor="#111111"
        android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:background="@drawable/agora_header_plain" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/agoraSessionTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Kalamos Notes" android:textSize="16sp"
            android:textColor="#111111" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/agoraSessionSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Agora draft" android:singleLine="true" android:textSize="12sp" android:textColor="#444444" />
    </LinearLayout>
    <Button android:id="@+id/agoraOptions" android:layout_width="40dp" android:layout_height="48dp"
        android:minWidth="0dp" android:padding="0dp" android:text="⋮" android:textSize="26sp"
        android:contentDescription="Attachment options" android:textColor="#111111"
        android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:background="@drawable/agora_header_plain" />
    <Button android:id="@+id/agoraAttach" android:layout_width="124dp" android:layout_height="48dp"
        android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:text="Attach to chat" android:textSize="14sp" android:textAllCaps="false"
        android:textColor="#111111" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:background="@drawable/agora_header_primary" />
</LinearLayout>
